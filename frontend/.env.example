# API Endpoint — REQUIRED
# Base URL of the API Gateway stage that serves /chat and /journal.
# There is no built-in fallback: if this is unset the app will surface an
# error rather than silently baking a production URL into the bundle.
#
# Local development typically points at a dev stage or `sam local start-api`:
#   REACT_APP_API_ENDPOINT=http://localhost:3001
REACT_APP_API_ENDPOINT=
