# API Endpoint — REQUIRED
# Base URL of the API Gateway stage serving /session, /chat and /journal.
# There is no built-in fallback: if this is unset the app surfaces an error
# rather than silently baking a production URL into the bundle.
REACT_APP_API_ENDPOINT=

# Cloudflare Turnstile site key — REQUIRED
# The public half of the Turnstile keypair (the secret half lives only in the
# backend). Without it the browser cannot obtain a session and every API call
# will fail. Create a widget for saheeh.ai at:
#   https://dash.cloudflare.com/?to=/:account/turnstile
REACT_APP_TURNSTILE_SITE_KEY=
